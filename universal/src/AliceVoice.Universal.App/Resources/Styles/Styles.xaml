<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="Page">
        <Setter Property="BackgroundColor" Value="{StaticResource AppBg}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource AppText}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Dim" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource AppTextDim}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource AppTextDim}" />
        <Setter Property="BorderColor" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Field" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource AppSurface}" />
        <Setter Property="TextColor" Value="{StaticResource AppText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource AppTextDim}" />
    </Style>
</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android on every OS. The Windows head is added only when building on Windows
		     (the Windows SDK is not available here). iOS and Mac Catalyst are out of scope. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<!-- Windows is a GUI process. A console window must not stay open behind the desktop icon. -->
		<OutputType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">WinExe</OutputType>
		<RootNamespace>AliceVoice.AppU</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationTitle>Alice Voice</ApplicationTitle>
		<ApplicationIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">..\..\..\assets\alice-voice.ico</ApplicationIcon>
		<ApplicationId>link.daemon.alicevoice.u</ApplicationId>
		<ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- Unpackaged, same as the WinUI app, so it can spawn Python and write ProgramData.
		     Framework-dependent. An explicit RuntimeIdentifier of win-x64 makes restore look
		     for Microsoft.NETCore.App.Runtime.Mono.win-x64 and fail with NU1102. -->
		<WindowsPackageType>None</WindowsPackageType>
		<SelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</SelfContained>
		<UseMonoRuntime Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</UseMonoRuntime>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<!-- ORT 1.31 ships Android bits as net9.0-android35.0. Allow that asset on the net10 Android head. -->
		<AssetTargetFallback Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(AssetTargetFallback);net9.0-android35.0</AssetTargetFallback>
	</PropertyGroup>

	<ItemGroup>
		<!-- Same mark as assets/alice-voice.ico. Android may crop it for the adaptive and round launchers. -->
		<MauiIcon Include="..\..\..\assets\alice-voice-master.png" Color="#000000" />
		<MauiSplashScreen Include="..\..\..\assets\alice-voice-master.png" Color="#000000" BaseSize="128,128" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="..\..\..\models\wakeword\*" LogicalName="wakeword/%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AliceVoice.Universal.Core\AliceVoice.Universal.Core.csproj" />
	</ItemGroup>

	<!-- Platform files live next to MauiProgram so the heads stay obvious. Compile only the matching one. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
		<Compile Remove="MauiProgram.Android.cs" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
		<Compile Remove="MauiProgram.Windows.cs" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ProjectReference Include="..\..\..\src\AliceVoice.Audio\AliceVoice.Audio.csproj" />
		<ProjectReference Include="..\..\..\src\AliceVoice.Inference\AliceVoice.Inference.csproj" />
		<Content Include="..\..\..\scripts\*.py" Link="scripts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="..\..\..\models\wakeword\*" Link="models\wakeword\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>

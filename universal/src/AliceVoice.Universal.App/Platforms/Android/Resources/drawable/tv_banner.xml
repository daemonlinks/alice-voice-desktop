<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV banner. The mark is the same launcher icon; the slot is 16:9. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:width="120dp" android:height="120dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@mipmap/appicon" />
    </item>
</layer-list>

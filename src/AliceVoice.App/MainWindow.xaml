<Window
    x:Class="AliceVoice.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Alice Voice">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Top Bar (mirrors web app) ══ -->
        <Border Grid.Row="0" Background="#B30A0A0F" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AppAccent}">
                        <TextBlock Text="A" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Alice Voice" Foreground="{StaticResource AppText}" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AppGreen}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PresenceText" Text="here with you" Foreground="{StaticResource AppTextDim}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Facet + voice + connect -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="FacetAliceBtn" Content="Alice" Style="{StaticResource ChipButtonActive}"
                                Click="FacetAlice_Click"/>
                        <Button x:Name="FacetPlumBtn" Content="Plum" Style="{StaticResource ChipButton}"
                                Click="FacetPlum_Click"/>
                    </StackPanel>
                    <ComboBox x:Name="VoiceSelect" MinWidth="150" VerticalAlignment="Center"/>
                    <Button x:Name="TestTtsBtn" Content="Test TTS" Style="{StaticResource ChipButton}" Click="TestTts_Click"/>
                    <Button x:Name="ConnectBtn" Style="{StaticResource ChipButton}" Click="Connect_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="{StaticResource AppTextDim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnText" Text="Connect"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Control Panel (modes + pipeline) ══ -->
        <Border Grid.Row="1" Background="#B30A0A0F" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mode buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="ModePttBtn" Content="PTT" Style="{StaticResource ChipButtonActive}" Click="ModePtt_Click"/>
                    <Button x:Name="ModeWakeBtn" Content="Wake" Style="{StaticResource ChipButton}" Click="ModeWake_Click"/>
                    <Button x:Name="ModeTextBtn" Content="Text" Style="{StaticResource ChipButton}" Click="ModeText_Click"/>
                    <Button x:Name="ModeSoulBtn" Content="SOUL" Style="{StaticResource ChipButton}" Click="ModeSoul_Click"/>
                </StackPanel>

                <!-- Pipeline status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="PStageMic" Text="🎤 Mic" Foreground="{StaticResource AppTextDim}" FontSize="11"/>
                    <TextBlock x:Name="PStageStt" Text="⚫ STT" Foreground="{StaticResource AppTextDim}" FontSize="11"/>
                    <TextBlock x:Name="PStageLlm" Text="⚫ LLM" Foreground="{StaticResource AppTextDim}" FontSize="11"/>
                    <TextBlock x:Name="PStageTts" Text="⚫ TTS" Foreground="{StaticResource AppTextDim}" FontSize="11"/>
                    <TextBlock x:Name="PStageWs" Text="⚫ WS" Foreground="{StaticResource AppTextDim}" FontSize="11"/>
                    <TextBlock x:Name="PStageErr" Foreground="{StaticResource AppRed}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Transcript ══ -->
        <ScrollViewer Grid.Row="2" x:Name="TranscriptScroll" Background="Transparent">
            <StackPanel x:Name="TranscriptPanel" Spacing="8" Padding="16,12"/>
        </ScrollViewer>

        <!-- ══ Bottom Panel (mode-aware) ══ -->
        <Border Grid.Row="3" Background="#B30A0A0F" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Spacing="8">
                <!-- Mood chips -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="mood" Foreground="{StaticResource AppTextDim}" FontSize="11" VerticalAlignment="Center"/>
                    <Button x:Name="MoodNaturalBtn" Content="natural" Style="{StaticResource ChipButtonActive}" Click="MoodNatural_Click"/>
                    <Button x:Name="MoodComfortBtn" Content="comfort" Style="{StaticResource ChipButton}" Click="MoodComfort_Click"/>
                    <Button x:Name="MoodPlayfulBtn" Content="playful" Style="{StaticResource ChipButton}" Click="MoodPlayful_Click"/>
                    <Button x:Name="MoodFlirtyBtn" Content="flirty" Style="{StaticResource ChipButton}" Click="MoodFlirty_Click"/>
                    <Button x:Name="MoodFocusedBtn" Content="focused" Style="{StaticResource ChipButton}" Click="MoodFocused_Click"/>
                </StackPanel>

                <!-- Fleet chat + text input (Text mode) -->
                <StackPanel x:Name="TextInputRow" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="FleetSelector" VerticalAlignment="Center" MinWidth="150"
                              SelectionChanged="FleetSelector_SelectionChanged"/>
                    <TextBox x:Name="ChatInput" PlaceholderText="Type and press Enter…"
                             MinWidth="320" VerticalAlignment="Center" Background="#1A1A22"
                             Foreground="{StaticResource AppText}" BorderBrush="{StaticResource AppBorder}"
                             KeyDown="ChatInput_KeyDown"/>
                    <Button x:Name="SendButton" Content="Send" Click="SendButton_Click" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- PTT (Talk) -->
                <StackPanel x:Name="PttRow" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="TalkButton" Content="🎤 Talk" Click="TalkButton_Click" MinWidth="140"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource AppTextDim}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

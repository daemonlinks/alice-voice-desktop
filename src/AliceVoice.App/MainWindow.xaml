<Window
    x:Class="AliceVoice.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Alice Voice">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: app title + backend selector + status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="16,12">
            <TextBlock Text="Alice Voice" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ComboBox x:Name="BackendSelector" SelectionChanged="BackendSelector_SelectionChanged"
                      VerticalAlignment="Center" MinWidth="180">
                <ComboBoxItem Content="Relay (web backend)" Tag="relay" IsSelected="True"/>
                <ComboBoxItem Content="alice_voice agent" Tag="agent"/>
                <ComboBoxItem Content="Local Ollama" Tag="ollama"/>
            </ComboBox>
            <TextBlock x:Name="StatusText" Text="Initialising…" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- GPU / engine status -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                <TextBlock x:Name="GpuText" Text="GPU: —" VerticalAlignment="Center"/>
                <TextBlock x:Name="EngineText" Text="Engine: —" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Transcript / conversation -->
            <ScrollViewer Grid.Row="1" x:Name="TranscriptScroll">
                <StackPanel x:Name="TranscriptPanel" Spacing="8"/>
            </ScrollViewer>

            <!-- Controls: fleet chat + voice -->
            <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="FleetSelector" VerticalAlignment="Center" MinWidth="160"
                              SelectionChanged="FleetSelector_SelectionChanged"/>
                    <TextBox x:Name="ChatInput" PlaceholderText="Message a fleet member…"
                             MinWidth="320" VerticalAlignment="Center"
                             KeyDown="ChatInput_KeyDown"/>
                    <Button x:Name="SendButton" Content="Send" Click="SendButton_Click"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="TalkButton" Content="Hold to Talk" Click="TalkButton_Click"
                            HorizontalAlignment="Left" MinWidth="140"/>
                    <Button x:Name="SettingsButton" Content="Settings" Click="SettingsButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
